await (async page => {
  const out={};
  const dir='D:/HEPLab/output/playwright/';
  const ensure=(ok,message)=>{if(!ok)throw Error(message);};
  const baseId=await page.locator('#run-history button.active').getAttribute('title');
  ensure(await page.getByRole('combobox',{name:'Engine',exact:true}).inputValue()==='rust','Rust must be available and selected');
  ensure(await page.locator('.plot svg').count()===4,'Expected four computed charts');
  out.metrics=await page.locator('#analysis-metrics').innerText();
  await page.getByRole('tab',{name:'Event display',exact:true}).click();
  const first=await page.locator('#particle-rows').innerText();
  await page.getByRole('button',{name:'Next event',exact:true}).click();
  await page.waitForFunction(()=>document.getElementById('event-index').value==='1');
  out.event_one_table=await page.locator('#particle-rows').innerText();
  ensure(first!==out.event_one_table,'Different events must show different kinematics');
  await page.screenshot({path:dir+'desktop-fix-event-1.png'});
  await page.getByRole('button',{name:'Previous event',exact:true}).click();
  await page.waitForFunction(()=>document.getElementById('event-index').value==='0');
  ensure(await page.locator('#particle-rows').innerText()===first,'Event 0 must reproduce exactly');
  await page.getByRole('tab',{name:'Run analysis',exact:true}).click();
  await page.getByRole('button',{name:'Run next seed',exact:true}).click();
  await page.getByRole('status').filter({hasText:'COMPLETED'}).waitFor();
  await page.waitForFunction(()=>document.getElementById('analysis-scope').textContent.includes('seed 43'));
  const oldId=baseId;
  await page.getByRole('combobox',{name:'Compare with',exact:true}).selectOption(oldId);
  await page.getByRole('columnheader',{name:'Difference',exact:true}).waitFor();
  out.comparison=await page.locator('#comparison-table').innerText();
  await page.screenshot({path:dir+'desktop-fix-comparison.png'});
  const downloaded=page.waitForEvent('download');
  await page.getByRole('button',{name:'Export result…',exact:true}).click();
  const event=await downloaded;await event.saveAs(dir+'desktop-fix-event.json');out.export_name=event.suggestedFilename();
  ensure(out.export_name!=='heplab-event-0.json','Export filename must identify the run');
  const setupDownload=page.waitForEvent('download');
  await page.getByRole('button',{name:'Save setup…',exact:true}).click();
  const setup=await setupDownload;await setup.saveAs(dir+'desktop-fix-setup.json');
  await page.getByRole('tab',{name:'Parameters',exact:true}).click();
  const momentum=page.getByRole('spinbutton',{name:'Muon |p| GeV/c',exact:true});
  await momentum.fill('20');await momentum.press('Tab');
  ensure(await page.locator('#configuration-error').isVisible(),'Cross-field response error must be visible');
  await page.setViewportSize({width:1100,height:680});
  ensure(await page.locator('#dirty').isVisible(),'Stale warning must survive minimum window size');
  await page.screenshot({path:dir+'desktop-fix-minimum-size.png'});
  await page.locator('#setup-file').setInputFiles(dir+'desktop-fix-setup.json');
  await page.waitForFunction(()=>document.getElementById('momentum').value==='45');
  ensure(await momentum.inputValue()==='45','Setup must restore saved parameters');
  await page.reload();
  await page.locator('#run-history button').first().waitFor();
  out.restored_runs=await page.locator('#run-history button').count();
  ensure(out.restored_runs>=2,'Persisted runs must load after reload');
  await page.locator('#run-history button').filter({hasText:oldId.slice(0,8)}).click();
  await page.locator('#analysis-content').waitFor();
  await page.getByRole('tab',{name:'Parameters',exact:true}).click();
  ensure(await momentum.inputValue()==='45','Recalled run parameters must match its result');
  ensure((await page.locator('#analysis-scope').innerText()).includes('seed 42'),'Recalled result must identify its original seed');
  await page.getByRole('tab',{name:'Event display',exact:true}).click();
  await page.getByRole('button',{name:'Next event',exact:true}).click();
  await page.waitForFunction(()=>document.getElementById('event-index').value==='1');
  out.restored_event_navigates=true;
  await page.getByRole('tab',{name:'Parameters',exact:true}).click();
  await page.getByRole('combobox',{name:'Tracking response',exact:true}).selectOption('ideal');
  await page.getByRole('combobox',{name:'Engine',exact:true}).selectOption('reference');
  await page.getByRole('spinbutton',{name:'Event budget',exact:true}).fill('200');
  await page.getByRole('spinbutton',{name:'Event budget',exact:true}).press('Tab');
  await page.getByRole('button',{name:'▶ Run',exact:true}).click();
  await page.getByRole('button',{name:'■ Stop',exact:true}).click();
  await page.getByRole('status').filter({hasText:'CANCELLED'}).waitFor();
  out.cancelled=true;
  await page.getByRole('spinbutton',{name:'Event budget',exact:true}).fill('2');
  await page.getByRole('spinbutton',{name:'Event budget',exact:true}).press('Tab');
  await page.route('**/api/v1/jobs/*',async route=>{
    const response=await route.fetch(),body=await response.json();
    if(body.status==='completed')for(const track of body.result.tracks)track.material.energy_residual_gev=.5;
    await route.fulfill({response,json:body});
  });
  await page.getByRole('button',{name:'▶ Run',exact:true}).click();
  await page.getByRole('status').filter({hasText:'COMPLETED'}).waitFor();
  await page.getByRole('button',{name:'Open capability report'}).click();
  const row=page.getByRole('row').filter({hasText:'Event energy ledger'});
  out.fault_injection=await row.innerText();ensure(out.fault_injection.includes('Failed'),'Bad conservation residual must fail');
  await row.scrollIntoViewIfNeeded();await page.screenshot({path:dir+'desktop-fix-failed-ledger.png'});
  await page.unroute('**/api/v1/jobs/*');await page.reload();
  await page.setViewportSize({width:1440,height:1000});
  await page.locator('#run-history button').filter({hasText:oldId.slice(0,8)}).click();
  await page.locator('#analysis-content').waitFor();
  await page.getByRole('tab',{name:'Run analysis',exact:true}).click();
  await page.screenshot({path:dir+'desktop-fix-analysis.png'});
  return out;
}
)(page);
