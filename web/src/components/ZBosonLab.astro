<section class="zlab" aria-label="Guided Z boson lab">
  <header class="zlab-intro">
    <div>
      <p class="zlab-kicker">HEPLab · Guided investigation 01</p>
      <h2>Rediscover the Z boson</h2>
      <p>Make the analysis choices, check one event by hand, and follow the mass peak to a measurement.</p>
    </div>
    <div class="zlab-meta"><span>~60 minutes</span><span>6 checkpoints</span><span>Saved in this browser</span></div>
  </header>

  <div class="zlab-workspace">
    <aside class="zlab-rail" aria-label="Lab progress">
      <div class="zlab-rail-head"><strong>Your investigation</strong><span id="zlab-progress-label">0 / 6</span></div>
      <div class="zlab-progress" role="progressbar" aria-label="Lab progress" aria-valuemin="0" aria-valuemax="6" aria-valuenow="0"><i id="zlab-progress-fill"></i></div>
      <nav class="zlab-steps" id="zlab-step-list" aria-label="Lab checkpoints"></nav>
      <div class="zlab-rail-actions"><span id="zlab-save-label">Progress saves in this browser</span><button class="zlab-text-button" id="zlab-reset" type="button">Start over</button></div>
    </aside>
    <article class="zlab-stage" id="zlab-stage" tabindex="-1" aria-live="polite"></article>
  </div>

  <p class="zlab-footnote">Teaching sample · Deterministic synthetic events · Not CMS collision data</p>
</section>

<script>
  import demo from '../data/z-boson-demo.json';

  const steps = [
    { id: 'load', title: 'Get oriented', sub: 'Meet the events', task: 'Check what is in this deterministic teaching sample. Every event is synthetic and generated offline.', hints: ['Start with the event count and the number of events containing a muon pair.'] },
    { id: 'select', title: 'Choose muons', sub: 'Make a selection', task: 'Set pT ≥ 20 GeV, relative isolation ≤ 0.15, and require opposite charge. These exact cuts are used for the spectrum below.', hints: ['Z bosons are neutral, so the two muons have opposite charge.', 'Energetic, isolated muons help keep the Z signal. Use pT ≥ 20 GeV and isolation ≤ 0.15.'] },
    { id: 'mass', title: 'Rebuild a mass', sub: 'One event, by hand', task: 'Reconstruct the invariant mass of these two muons. Work it out before entering your answer in GeV.', hints: ['For each muon, pz = pT sinh(η), px = pT cos(φ), and py = pT sin(φ).', 'Add the four-vectors, then use m² = E² − |p|².'] },
    { id: 'histogram', title: 'Look for a peak', sub: 'Many events together', task: 'Apply the selection to the sample. Is the tallest mass bin above 50 GeV in the Z region?', hints: ['The Z peak is near 91 GeV.', 'The histogram uses the selection you just entered.'] },
    { id: 'fit', title: 'Measure the Z', sub: 'Fit and uncertainty', task: 'Read the fit report and enter the measured mass and statistical uncertainty. Compare your result with the PDG reference.', hints: ['The fitted mass should be close to 91.1876 GeV.', 'A well-populated sample should give an uncertainty below 1 GeV.'] },
    { id: 'width', title: 'Explain the width', sub: 'What broadens the peak?', task: 'The measured mass peak is wider than the Z boson’s natural width. What is the main reason in this dimuon measurement?', hints: ['Think about how precisely the detector measures each muon momentum.'] }
  ];

  type LabState = {
    done: string[];
    settings: { pt: number; iso: number; opposite: boolean };
    selected: number;
    hints: Record<string, number>;
  };
  type UiHandler = (event: Event) => void;
  type UiAttributes = Record<string, string | number | boolean | UiHandler>;

  const root = document.querySelector<HTMLElement>('.zlab')!;
  const storageKey = 'heplab-z-lab-v1';
  const fresh = (): LabState => ({ done: [], settings: { pt: 0, iso: 1, opposite: false }, selected: 0, hints: {} });
  let state: LabState;
  try { state = { ...fresh(), ...JSON.parse(localStorage.getItem(storageKey) || '{}') }; }
  catch { state = fresh(); }
  state.done = Array.isArray(state.done) ? state.done : [];
  state.settings = { ...fresh().settings, ...state.settings };
  state.hints = state.hints || {};

  const stage = root.querySelector<HTMLElement>('#zlab-stage')!;
  const stepNav = root.querySelector<HTMLElement>('#zlab-step-list')!;
  const make = <K extends keyof HTMLElementTagNameMap,>(tag: K, attrs: UiAttributes = {}, ...children: (Node | string)[]): HTMLElementTagNameMap[K] => {
    const node = document.createElement(tag);
    for (const [key, value] of Object.entries(attrs)) {
      if (key === 'text') node.textContent = String(value);
      else if (key === 'class') node.className = String(value);
      else if (key.startsWith('on') && typeof value === 'function') node.addEventListener(key.slice(2), value);
      else if (typeof value === 'boolean') { if (value) node.setAttribute(key, ''); }
      else node.setAttribute(key, String(value));
    }
    node.append(...children);
    return node;
  };
  const persist = () => {
    try { localStorage.setItem(storageKey, JSON.stringify(state)); root.querySelector<HTMLElement>('#zlab-save-label')!.textContent = 'Saved just now'; }
    catch { root.querySelector<HTMLElement>('#zlab-save-label')!.textContent = 'Progress stays in this tab'; }
  };
  const firstOpen = () => steps.findIndex(step => !state.done.includes(step.id));
  const feedback = (area: HTMLElement, passed: boolean, message: string) => {
    area.className = `zlab-feedback ${passed ? 'is-good' : 'is-try'}`;
    area.textContent = `${passed ? 'Checkpoint complete · ' : 'Try again · '}${message}`;
    area.hidden = false;
  };
  const complete = (step: (typeof steps)[number], area: HTMLElement, message: string) => {
    state.done = [...new Set([...state.done, step.id])];
    state.selected = Math.min(firstOpen() === -1 ? 5 : firstOpen(), 5);
    persist();
    feedback(area, true, message);
    setTimeout(render, 450);
  };
  function drawHistogram(canvas: HTMLCanvasElement) {
    const histogram = demo.histogram;
    const context = canvas.getContext('2d');
    if (!context) return;
    const rect = canvas.getBoundingClientRect();
    const ratio = devicePixelRatio || 1;
    canvas.width = rect.width * ratio;
    canvas.height = rect.height * ratio;
    context.scale(ratio, ratio);
    const width = rect.width, height = rect.height, left = 42, right = 10, top = 10, bottom = 28;
    const max = Math.max(...histogram.counts) * 1.1;
    context.clearRect(0, 0, width, height);
    const css = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
    context.strokeStyle = css('--sl-color-hairline');
    context.fillStyle = css('--sl-color-gray-3');
    context.font = '10px system-ui';
    for (let index = 0; index <= 4; index++) {
      const y = top + (height - top - bottom) * index / 4;
      context.beginPath(); context.moveTo(left, y); context.lineTo(width - right, y); context.stroke();
    }
    for (let index = 0; index < histogram.counts.length; index++) {
      const x = left + (width - left - right) * index / histogram.counts.length;
      const barHeight = (height - top - bottom) * histogram.counts[index] / max;
      context.fillStyle = histogram.edges[index] > 86 && histogram.edges[index] < 96
        ? css('--sl-color-accent') : css('--sl-color-gray-4');
      context.fillRect(x, height - bottom - barHeight, (width - left - right) / histogram.counts.length - 1, barHeight);
    }
    context.fillStyle = css('--sl-color-gray-3');
    for (let value = 40; value <= 140; value += 20) {
      const x = left + (width - left - right) * (value - 40) / 100;
      context.fillText(`${value} GeV`, x - 15, height - 7);
    }
  }

  function render() {
    const doneCount = state.done.length;
    const stepIndex = Math.max(0, Math.min(state.selected, 5));
    const step = steps[stepIndex];
    root.querySelector<HTMLElement>('#zlab-progress-label')!.textContent = `${doneCount} / 6`;
    root.querySelector<HTMLElement>('[role=progressbar]')!.setAttribute('aria-valuenow', String(doneCount));
    root.querySelector<HTMLElement>('#zlab-progress-fill')!.style.width = `${doneCount / 6 * 100}%`;
    stepNav.replaceChildren(...steps.map((item, index) => {
      const button = make('button', {
        class: `zlab-step-link ${state.done.includes(item.id) ? 'is-done' : ''}`,
        type: 'button',
        'aria-current': index === stepIndex ? 'step' : 'false',
        disabled: index > firstOpen() && !state.done.includes(item.id),
        onclick: () => { state.selected = index; persist(); render(); }
      });
      button.append(make('span', { class: 'zlab-step-num', text: state.done.includes(item.id) ? '✓' : String(index + 1) }),
        make('span', { class: 'zlab-step-copy' }, make('span', { class: 'zlab-step-title', text: item.title }), make('span', { class: 'zlab-step-sub', text: item.sub })));
      return button;
    }));

    stage.replaceChildren();
    const top = make('div', { class: 'zlab-stage-top' },
      make('span', { class: 'zlab-overline', text: `Checkpoint ${String(stepIndex + 1).padStart(2, '0')} / 06` }),
      make('span', { class: 'zlab-saved', text: 'Progress saved locally' }));
    stage.append(top, make('h3', { class: 'zlab-stage-title', text: step.title }), make('p', { class: 'zlab-task', text: step.task }));
    const card = make('section', { class: 'zlab-activity', 'aria-label': 'Checkpoint activity' });
    card.append(make('div', { class: 'zlab-overline', text: 'Your task' }));
    const result = make('div', { class: 'zlab-feedback', hidden: true, 'aria-live': 'polite' });

    if (step.id === 'load') {
      const metrics = make('div', { class: 'zlab-metrics' });
      for (const [value, label] of [[demo.events.toLocaleString(), 'synthetic practice events'], [demo.events_with_muon_pair.toLocaleString(), 'events with a muon pair'], ['offline', 'no account or download required']]) {
        metrics.append(make('div', { class: 'zlab-metric' }, make('b', { text: value }), make('span', { text: label })));
      }
      const load = make('button', { class: 'zlab-primary', type: 'button', text: 'Load the practice sample' });
      load.onclick = () => complete(step, result, `Loaded ${demo.events.toLocaleString()} events; ${demo.events_with_muon_pair.toLocaleString()} contain a muon pair.`);
      card.append(metrics, make('div', { class: 'zlab-actions' }, load));
    } else if (step.id === 'select') {
      const pt = make('input', { class: 'zlab-field', type: 'number', min: '0', max: '100', step: '1', value: state.settings.pt, 'aria-label': 'Minimum muon transverse momentum in GeV' });
      const isolation = make('input', { class: 'zlab-field', type: 'number', min: '0', max: '2', step: '0.05', value: state.settings.iso, 'aria-label': 'Maximum relative isolation' });
      const opposite = make('input', { type: 'checkbox', 'aria-label': 'Require opposite charge' });
      opposite.checked = !!state.settings.opposite;
      card.append(make('label', { class: 'zlab-form-row' }, make('span', { text: 'Minimum muon pT' }), pt, make('span', { text: 'GeV' })),
        make('label', { class: 'zlab-form-row' }, make('span', { text: 'Maximum relative isolation' }), isolation),
        make('label', { class: 'zlab-check-row' }, opposite, make('span', { text: 'Require opposite charge' })));
      const check = make('button', { class: 'zlab-primary', type: 'button', text: 'Check my selection' });
      check.onclick = () => {
        state.settings = { pt: Number(pt.value), iso: Number(isolation.value), opposite: opposite.checked };
        persist();
        const passed = Math.abs(state.settings.pt - 20) < 1e-9 && Math.abs(state.settings.iso - .15) < 1e-9 && state.settings.opposite;
        if (passed) complete(step, result, 'Good choice: energetic, isolated, opposite-charge muons select neutral Z decays.');
        else feedback(result, false, 'For this result use pT ≥ 20 GeV, relative isolation ≤ 0.15, and opposite charge.');
      };
      card.append(make('div', { class: 'zlab-actions' }, check));
    } else if (step.id === 'mass') {
      const [first, second] = demo.muons;
      const describe = (muon: (typeof demo.muons)[number]) => `pT ${muon.pt.toFixed(2)} GeV · η ${muon.eta.toFixed(3)} · φ ${muon.phi.toFixed(3)} · q ${muon.charge > 0 ? '+' : '−'}`;
      const muons = make('div', { class: 'zlab-muons' });
      for (const [index, muon] of [first, second].entries()) muons.append(make('div', { class: 'zlab-muon' }, make('strong', { text: `Muon ${index + 1}` }), make('span', { text: describe(muon) })));
      const answer = make('input', { class: 'zlab-field', type: 'number', step: '0.001', placeholder: 'e.g. 91.2', 'aria-label': 'Invariant mass in GeV' });
      const check = make('button', { class: 'zlab-primary', type: 'button', text: 'Check the mass' });
      check.onclick = () => {
        const value = Number(answer.value);
        const passed = Number.isFinite(value) && Math.abs(value - demo.hand_mass_gev) / demo.hand_mass_gev <= .001;
        if (passed) complete(step, result, `Correct. The reference calculation is ${demo.hand_mass_gev.toFixed(3)} GeV.`);
        else feedback(result, false, 'Rebuild both four-vectors, including the muon mass, before adding them.');
      };
      card.append(muons, make('div', { class: 'zlab-formula', text: 'm² = (E₁ + E₂)² − |p⃗₁ + p⃗₂|²' }),
        make('label', { class: 'zlab-form-row' }, make('span', { text: 'Invariant mass' }), answer, make('span', { text: 'GeV' })),
        make('div', { class: 'zlab-actions' }, check));
    } else if (step.id === 'histogram') {
      const canvas = make('canvas', { class: 'zlab-chart', role: 'img', 'aria-label': 'Dimuon mass histogram. Highlighted bins mark the Z mass region.' });
      const metrics = make('div', { class: 'zlab-metrics' },
        make('div', { class: 'zlab-metric' }, make('b', { text: demo.histogram.entries.toLocaleString() }), make('span', { text: 'selected pairs' })),
        make('div', { class: 'zlab-metric' }, make('b', { text: '40–140' }), make('span', { text: 'mass range · GeV' })));
      card.append(metrics, make('div', { class: 'zlab-chart-wrap' }, canvas));
      requestAnimationFrame(() => drawHistogram(canvas));
      const check = make('button', { class: 'zlab-primary', type: 'button', text: 'Check the peak' });
      check.onclick = () => {
        const counts = demo.histogram.counts, edges = demo.histogram.edges;
        const index = counts.reduce((best, count, current) => edges[current] >= 50 && count > counts[best] ? current : best, 0);
        const peak = (edges[index] + edges[index + 1]) / 2;
        if (demo.histogram.entries >= 200 && peak >= 86 && peak <= 96) complete(step, result, `The tallest bin is at ${peak.toFixed(1)} GeV. That is the Z boson.`);
        else feedback(result, false, 'Check that your selection keeps the Z events.');
      };
      card.append(make('div', { class: 'zlab-actions' }, check));
    } else if (step.id === 'fit') {
      const fit = demo.fit;
      const metrics = make('div', { class: 'zlab-metrics' },
        make('div', { class: 'zlab-metric' }, make('b', { text: fit.values.mean.toFixed(2) }), make('span', { text: 'fitted mass · GeV' })),
        make('div', { class: 'zlab-metric' }, make('b', { text: fit.errors.mean.toFixed(2) }), make('span', { text: 'statistical uncertainty · GeV' })),
        make('div', { class: 'zlab-metric' }, make('b', { text: demo.reference_mass_gev.toFixed(2) }), make('span', { text: 'PDG reference mass · GeV' })));
      const mass = make('input', { class: 'zlab-field', type: 'number', step: '.01', placeholder: 'mass', 'aria-label': 'Fitted mass in GeV' });
      const uncertainty = make('input', { class: 'zlab-field', type: 'number', step: '.01', placeholder: 'uncertainty', 'aria-label': 'Fit uncertainty in GeV' });
      const check = make('button', { class: 'zlab-primary', type: 'button', text: 'Check the measurement' });
      check.onclick = () => {
        const value = Number(mass.value), error = Number(uncertainty.value);
        const passed = Number.isFinite(value) && Number.isFinite(error) && error > 0 && Math.abs(value - demo.reference_mass_gev) <= 1 && error < 1;
        if (passed) complete(step, result, `m = ${value.toFixed(2)} ± ${error.toFixed(2)} GeV, consistent with the reference.`);
        else feedback(result, false, 'Report a mass within 1 GeV of the reference and an uncertainty below 1 GeV.');
      };
      card.append(make('div', { class: 'zlab-overline', text: 'Gaussian + background fit report' }), metrics,
        make('label', { class: 'zlab-form-row' }, make('span', { text: 'Your result' }), mass, make('span', { text: '±' }), uncertainty, make('span', { text: 'GeV' })),
        make('div', { class: 'zlab-actions' }, check));
    } else {
      const choices = [
        ['a', 'The Z boson lives long enough to broaden the peak.'],
        ['b', 'Finite muon momentum resolution broadens the reconstructed mass.'],
        ['c', 'The histogram bin width is the only source of broadening.'],
        ['d', 'The Z boson has no natural width.']
      ];
      let selected = '';
      const group = make('div', { class: 'zlab-choices', role: 'group', 'aria-label': 'Why is the measured peak wider?' });
      for (const [key, label] of choices) {
        const button = make('button', { class: 'zlab-choice', type: 'button', 'aria-pressed': 'false', text: `${key.toUpperCase()} · ${label}` });
        button.onclick = () => { selected = key; for (const item of group.children) item.setAttribute('aria-pressed', String(item === button)); };
        group.append(button);
      }
      const check = make('button', { class: 'zlab-primary', type: 'button', text: 'Submit answer' });
      check.onclick = () => selected === 'b'
        ? complete(step, result, 'Exactly. The observed width combines the natural width with detector momentum resolution.')
        : feedback(result, false, 'Consider how precisely the detector measures each muon.');
      card.append(group, make('div', { class: 'zlab-actions' }, check));
    }

    const hint = make('div', { class: 'zlab-hint', hidden: true });
    const hintControl = make('button', { class: 'zlab-secondary', type: 'button', text: 'Need a hint?' });
    hintControl.onclick = () => {
      const index = state.hints[step.id] || 0;
      hint.textContent = step.hints[Math.min(index, step.hints.length - 1)];
      hint.hidden = false;
      state.hints[step.id] = Math.min(index + 1, step.hints.length);
      persist();
    };
    card.append(make('div', { class: 'zlab-actions' }, hintControl));
    stage.append(card, hint, result);

    if (state.done.length === 6) {
      stage.append(make('section', { class: 'zlab-completion' }, make('h4', { text: 'You found the Z.' }),
        make('p', { text: `Your fit measured ${demo.fit.values.mean.toFixed(2)} ± ${demo.fit.errors.mean.toFixed(2)} GeV. You followed the chain from event selection to a mass measurement.` }),
        make('div', { class: 'zlab-actions' },
          make('a', { class: 'zlab-primary', href: '/examples/synthetic-z-dimuon.html', text: 'Explore the shareable result' }),
          make('a', { class: 'zlab-secondary', href: '/reference/python-api-v1/', text: 'Continue in Python' }))));
    }
  }

  root.querySelector<HTMLButtonElement>('#zlab-reset')!.addEventListener('click', () => {
    state = fresh();
    persist();
    render();
    stage.focus();
  });
  render();
</script>
