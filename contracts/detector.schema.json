{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heplab.invalid/contracts/detector.schema.json",
  "title": "HEPLab target detector model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "fidelity",
    "units",
    "field",
    "geometry",
    "response"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "fidelity": {
      "enum": [
        "T0",
        "T1"
      ]
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "energy",
        "time",
        "field"
      ],
      "properties": {
        "length": {
          "const": "m"
        },
        "energy": {
          "const": "GeV"
        },
        "time": {
          "const": "ns"
        },
        "field": {
          "const": "T"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "bz"
      ],
      "properties": {
        "model": {
          "const": "uniform_axial"
        },
        "bz": {
          "type": "number"
        }
      }
    },
    "geometry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "volume_id",
          "shape",
          "radius",
          "half_length",
          "material"
        ],
        "properties": {
          "volume_id": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "const": "cylinder"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "half_length": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "material": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "efficiency",
        "relative_pt_resolution",
        "valid_pt",
        "valid_abs_eta",
        "calibration"
      ],
      "properties": {
        "mode": {
          "const": "object_fast"
        },
        "efficiency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relative_pt_resolution": {
          "type": "number",
          "minimum": 0
        },
        "valid_pt": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "valid_abs_eta": {
          "type": "number",
          "minimum": 0
        },
        "calibration": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fidelity": {
            "const": "T1"
          }
        }
      },
      "then": {
        "properties": {
          "response": {
            "properties": {
              "calibration": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
