{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HEPLab Event Export",
  "type": "object",
  "required": ["experiment_id", "run_id", "particles"],
  "properties": {
    "experiment_id": {"type": "string"},
    "run_id": {"type": "string"},
    "particles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "z", "px", "py", "pz", "charge", "mass"],
        "properties": {
          "id": {"type": "integer"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "z": {"type": "number"},
          "px": {"type": "number"},
          "py": {"type": "number"},
          "pz": {"type": "number"},
          "charge": {"type": "number"},
          "mass": {"type": "number"}
        }
      }
    }
  },
  "additionalProperties": false
}
