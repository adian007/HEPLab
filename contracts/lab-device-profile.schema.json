{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heplab.invalid/contracts/lab-device-profile.schema.json",
  "title": "Laboratory device profile v1",
  "description": "What is established about a physical detector. Unknown and reported values cannot drive computation; semantic rules are enforced by heplab.lab.profile.",
  "type": "object",
  "required": ["schema", "profile_id", "identification", "quantities", "channel_map", "clock", "control"],
  "additionalProperties": false,
  "$defs": {
    "established": {"enum": ["documented", "measured"]},
    "quantity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {"state": {"const": "unknown"}, "note": {"type": "string"}}
        },
        {
          "type": "object",
          "required": ["state", "value", "source"],
          "additionalProperties": false,
          "properties": {
            "state": {"enum": ["reported", "documented", "measured"]},
            "value": {},
            "unit": {"type": "string"},
            "source": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "properties": {
    "schema": {"const": "heplab-lab-device-profile-v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "identification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unidentified", "identified"]},
        "reported_description": {"type": "string"},
        "inspected": {"type": "boolean"},
        "next_steps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quantities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}},
    "channel_map": {
      "oneOf": [
        {"type": "object", "required": ["state"], "additionalProperties": false, "properties": {"state": {"const": "unknown"}}},
        {
          "type": "object",
          "required": ["state", "source", "channels"],
          "additionalProperties": false,
          "properties": {
            "state": {"$ref": "#/$defs/established"},
            "source": {"type": "string", "minLength": 1},
            "channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["channel"],
                "properties": {"channel": {"type": "integer", "minimum": 0}}
              }
            }
          }
        }
      ]
    },
    "clock": {
      "oneOf": [
        {"type": "object", "required": ["state"], "additionalProperties": false, "properties": {"state": {"const": "unknown"}}},
        {
          "type": "object",
          "required": ["state", "source", "tick_ns", "counter_bits"],
          "additionalProperties": false,
          "properties": {
            "state": {"$ref": "#/$defs/established"},
            "source": {"type": "string", "minLength": 1},
            "tick_ns": {"type": "number", "exclusiveMinimum": 0},
            "counter_bits": {"type": "integer", "minimum": 1, "maximum": 63}
          }
        }
      ]
    },
    "trigger_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["independent", "description"],
        "properties": {"independent": {"type": "boolean"}, "description": {"type": "string", "minLength": 1}}
      }
    },
    "control": {
      "type": "object",
      "required": ["permitted"],
      "properties": {
        "permitted": {"type": "boolean"},
        "operator": {"type": "string"},
        "approved_limits": {"type": "object"}
      }
    }
  }
}
