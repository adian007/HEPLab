{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HEPLab",
  "version": "0.1.0-dev.0",
  "identifier": "org.heplab.desktop",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "python prepare_frontend.py"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "HEPLab Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {"worker/": "worker/"},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Reproducible particle-physics simulation and laboratory replay",
    "linux": {
      "deb": {"depends": []}
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
