{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-ninja",
      "displayName": "Windows Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HEPLAB_BUILD_TESTS": "ON",
        "Qt6_DIR": "$env{HEPLAB_QT6_DIR}",
        "CMAKE_CXX_COMPILER": "$env{HEPLAB_CXX_COMPILER}",
        "CMAKE_RC_COMPILER": "$env{HEPLAB_RC_COMPILER}",
        "CMAKE_MT": "$env{HEPLAB_MT}"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HEPLAB_BUILD_TESTS": "ON",
        "Qt6_DIR": "$env{HEPLAB_QT6_DIR}",
        "CMAKE_CXX_COMPILER": "$env{HEPLAB_CXX_COMPILER}",
        "CMAKE_RC_COMPILER": "$env{HEPLAB_RC_COMPILER}",
        "CMAKE_MT": "$env{HEPLAB_MT}"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-vs2022",
      "cacheVariables": {
        "HEPLAB_BUILD_TESTS": "ON",
        "Qt6_DIR": "$env{HEPLAB_QT6_DIR}",
        "CMAKE_CXX_COMPILER": "$env{HEPLAB_CXX_COMPILER}",
        "CMAKE_RC_COMPILER": "$env{HEPLAB_RC_COMPILER}",
        "CMAKE_MT": "$env{HEPLAB_MT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja"
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "windows-vs2022",
      "configurePreset": "windows-vs2022"
    }
  ],
  "testPresets": [
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2022",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
